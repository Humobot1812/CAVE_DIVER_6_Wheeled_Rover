<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:property name="base_length" value="0.4"/>
    <xacro:property name="base_width" value="0.34"/>
    <xacro:property name="base_height" value="0.13"/>
    <xacro:property name="base_mass" value="6.485"/>

    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_length" value="0.045"/>
    <xacro:property name="wheel_mass" value="0.424"/>
    <xacro:property name="wheel_offset" value="0.12221"/>



    <xacro:macro name="cuboid_link" params="prefix m l b h x y z r p yaw material:=chassis_dark" >
        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <box size="${l} ${b} ${h}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}"/>
                <material name="${material}"><color rgba="0.30 0.33 0.37 1.0"/></material>
            </visual>
            <xacro:cuboid_collision lbh="${l} ${b} ${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
            <xacro:cuboid_inertia m="${m}" l="${l}" b="${b}" h="${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="cube_link" params="prefix m l b h x y z r p yaw material:=sensor_black" >
        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <box size="${l} ${b} ${h}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}"/>
                <material name="${material}"><color rgba="0.30 0.33 0.37 1.0"/></material>
            </visual>
            <xacro:cuboid_collision lbh="${l} ${b} ${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
            <xacro:cuboid_inertia m="${m}" l="${l}" b="${b}" h="${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="small_cuboid_link" params="prefix m l b h x y z r p yaw material:=deck_slate" >
        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <box size="${l} ${b} ${h}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${r} ${p} ${yaw}"/>
                <material name="${material}"><color rgba="0.30 0.33 0.37 1.0"/></material>
            </visual>
            <xacro:cuboid_collision lbh="${l} ${b} ${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
            <xacro:cuboid_inertia m="${m}" l="${l}" b="${b}" h="${h}" o_xyz="${x} ${y} ${z}" o_rpy="${r} ${p} ${yaw}"/>
        </link>
    </xacro:macro>


    <xacro:macro name="wheel_link" params="prefix m r l x y z roll p yaw material:=rubber_black">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${r}" length="${l}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="${material}"><color rgba="0.30 0.33 0.37 1.0"/></material>
            </visual>
            <xacro:cylinder_inertia m="${m}" r="${r}" l="${l}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
            <xacro:cylinder_collision r="${r}" l="${l}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
        </link>
    </xacro:macro>

    <!-- High-Detail Off-Road Beadlock Rover Wheel Macro -->
    <xacro:macro name="rover_wheel_link" params="prefix m r l x y z roll p yaw">
        <link name="${prefix}_wheel_link">
            <!-- 1. Outer Deep-Tread Rubber Tire -->
            <visual>
                <geometry>
                    <cylinder radius="${r}" length="${l - 0.002}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="tread_rubber"><color rgba="0.05 0.05 0.06 1.0"/></material>
            </visual>
            <!-- 2. Machined Alloy Outer Wheel Rim Lip -->
            <visual>
                <geometry>
                    <cylinder radius="${r * 0.74}" length="${l}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
            </visual>
            <!-- 3. Cyber Safety Orange Beadlock Accent Ring -->
            <visual>
                <geometry>
                    <cylinder radius="${r * 0.64}" length="${l + 0.001}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
            </visual>
            <!-- 4. Recessed Inner Hub Well -->
            <visual>
                <geometry>
                    <cylinder radius="${r * 0.44}" length="${l + 0.0018}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="stealth_carbon"><color rgba="0.10 0.11 0.13 1.0"/></material>
            </visual>
            <!-- 5. Central Machined Axle Nut -->
            <visual>
                <geometry>
                    <cylinder radius="${r * 0.20}" length="${l + 0.003}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
            </visual>
            <!-- 6. Heavy-Duty Machined Spokes (rotating dynamically with wheel) -->
            <visual>
                <geometry>
                    <box size="${r * 1.15} 0.007 ${l + 0.002}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
            </visual>
            <visual>
                <geometry>
                    <box size="${r * 1.15} 0.007 ${l + 0.002}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p + pi/3} ${yaw}"/>
                <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
            </visual>
            <visual>
                <geometry>
                    <box size="${r * 1.15} 0.007 ${l + 0.002}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p + 2*pi/3} ${yaw}"/>
                <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
            </visual>
            <xacro:cylinder_inertia m="${m}" r="${r}" l="${l}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
            <xacro:cylinder_collision r="${r}" l="${l}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="cylinder_link" params="prefix m r l x y z roll p yaw material:=gunmetal_suspension">
        <link name="${prefix}_cylinder_link">
            <!-- Main Suspension Linkage Shaft -->
            <visual>
                <geometry>
                    <cylinder radius="${r}" length="${l}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="${material}"><color rgba="0.30 0.33 0.37 1.0"/></material>
            </visual>
            <!-- CNC Machined Accent Collar -->
            <visual>
                <geometry>
                    <cylinder radius="${r * 1.15}" length="${l * 0.25}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
            </visual>
            <!-- Sealed Bearing Knuckle Pivot -->
            <visual>
                <geometry>
                    <sphere radius="${r * 1.10}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
                <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
            </visual>
            <xacro:cylinder_inertia m="${m}" r="${r}" l="${l}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
            <xacro:cylinder_collision r="${r}" l="${l}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="sphere_link" params="prefix m r x y z roll p yaw material:=sensor_black">
        <link name="${prefix}_sphere_link">
            <visual>
                <geometry>
                    <sphere radius="${r}"/>
                </geometry>
                <origin xyz="${x} ${y} ${z}" rpy="${roll} ${p} ${yaw}"/>
                <material name="${material}"><color rgba="0.30 0.33 0.37 1.0"/></material>
            </visual>
            <xacro:sphere_inertia m="${m}" r="${r}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
            <xacro:sphere_collision r="${r}" o_xyz="${x} ${y} ${z}" o_rpy="${roll} ${p} ${yaw}"/>
        </link>
    </xacro:macro>

    <link name="odom"/>
    <joint name="odom_to_base_footprint" type="fixed">
        <parent link="odom"/>
        <child  link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint"/>

    <!-- High-Tech Industrial Rover Main Body (base_link) -->
    <link name="base_link">
        <!-- 1. Core Stealth Carbon Composite Hull -->
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <material name="stealth_carbon"><color rgba="0.10 0.11 0.13 1.0"/></material>
        </visual>
        <!-- 2. Cyber Safety Orange Left Flank Armor Panel -->
        <visual>
            <geometry>
                <box size="0.30 0.005 0.040"/>
            </geometry>
            <origin xyz="0 ${base_width/2 + 0.002} ${base_height/2 + 0.015}" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- 3. Left Flank Inset Cooling Vent -->
        <visual>
            <geometry>
                <box size="0.12 0.007 0.024"/>
            </geometry>
            <origin xyz="0 ${base_width/2 + 0.002} ${base_height/2 + 0.015}" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <!-- 4. Cyber Safety Orange Right Flank Armor Panel -->
        <visual>
            <geometry>
                <box size="0.30 0.005 0.040"/>
            </geometry>
            <origin xyz="0 -${base_width/2 + 0.002} ${base_height/2 + 0.015}" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- 5. Right Flank Inset Cooling Vent -->
        <visual>
            <geometry>
                <box size="0.12 0.007 0.024"/>
            </geometry>
            <origin xyz="0 -${base_width/2 + 0.002} ${base_height/2 + 0.015}" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <!-- 6. Left Heavy-Duty Rocker Nerf Bar (Machined Alloy Tube) -->
        <!-- <visual>
            <geometry>
                <cylinder radius="0.011" length="0.36"/>
            </geometry>
            <origin xyz="0 ${base_width/2 + 0.015} 0.038" rpy="${pi/2} 0 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual> -->
        <visual>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <origin xyz="0.12 ${base_width/2 + 0.008} 0.038" rpy="0 0 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <origin xyz="-0.12 ${base_width/2 + 0.008} 0.038" rpy="0 0 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <!-- 7. Right Heavy-Duty Rocker Nerf Bar (Machined Alloy Tube) -->
        <!-- <visual>
            <geometry>
                <cylinder radius="0.011" length="0.36"/>
            </geometry>
            <origin xyz="0 -${base_width/2 + 0.015} 0.038" rpy="${pi/2} 0 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual> -->
        <visual>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <origin xyz="0.12 -${base_width/2 + 0.008} 0.038" rpy="0 0 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <origin xyz="-0.12 -${base_width/2 + 0.008} 0.038" rpy="0 0 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <!-- 8. Front Off-Road Tubular Bull Bar -->
        <visual>
            <geometry>
                <cylinder radius="0.013" length="0.32"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.018} 0 0.065" rpy="${pi/2} 0 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <cylinder radius="0.009" length="0.22"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.024} 0 0.098" rpy="${pi/2} 0 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.036 0.022 0.055"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.005} 0.11 0.065" rpy="0 0 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.036 0.022 0.055"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.005} -0.11 0.065" rpy="0 0 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <!-- 9. Front Underbody Skid Plate / Deflector -->
        <visual>
            <geometry>
                <box size="0.075 0.26 0.008"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.010} 0 0.025" rpy="0 0.48 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <!-- 10. Front Dual High-Intensity Xenon Headlights -->
        <visual>
            <geometry>
                <box size="0.02 0.052 0.03"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.004} 0.088 0.092" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.006 0.046 0.024"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.012} 0.088 0.092" rpy="0 0 0"/>
            <material name="headlight_xenon"><color rgba="0.92 0.96 1.0 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.02 0.052 0.03"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.004} -0.088 0.092" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.006 0.046 0.024"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.012} -0.088 0.092" rpy="0 0 0"/>
            <material name="headlight_xenon"><color rgba="0.92 0.96 1.0 1.0"/></material>
        </visual>
        <!-- 11. Front Center Amber Hazard Marker -->
        <visual>
            <geometry>
                <box size="0.006 0.060 0.012"/>
            </geometry>
            <origin xyz="${base_length/2 + 0.004} 0 0.10" rpy="0 0 0"/>
            <material name="hazard_amber"><color rgba="1.0 0.65 0.05 1.0"/></material>
        </visual>
        <!-- 12. Rear Heavy-Duty Tubular Bumper -->
        <visual>
            <geometry>
                <cylinder radius="0.013" length="0.32"/>
            </geometry>
            <origin xyz="-${base_length/2 + 0.018} 0 0.065" rpy="${pi/2} 0 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.036 0.022 0.055"/>
            </geometry>
            <origin xyz="-${base_length/2 + 0.005} 0.11 0.065" rpy="0 0 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.036 0.022 0.055"/>
            </geometry>
            <origin xyz="-${base_length/2 + 0.005} -0.11 0.065" rpy="0 0 0"/>
            <material name="gunmetal_suspension"><color rgba="0.30 0.33 0.37 1.0"/></material>
        </visual>
        <!-- 13. Rear Emergency Recovery Hitch Loop -->
        <visual>
            <geometry>
                <cylinder radius="0.016" length="0.018"/>
            </geometry>
            <origin xyz="-${base_length/2 + 0.022} 0 0.035" rpy="0 ${pi/2} 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- 14. Rear Dual Laser Red LED Taillights -->
        <visual>
            <geometry>
                <box size="0.02 0.048 0.026"/>
            </geometry>
            <origin xyz="-${base_length/2 + 0.004} 0.092 0.090" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.006 0.042 0.020"/>
            </geometry>
            <origin xyz="-${base_length/2 + 0.012} 0.092 0.090" rpy="0 0 0"/>
            <material name="taillight_red"><color rgba="0.95 0.08 0.08 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.02 0.048 0.026"/>
            </geometry>
            <origin xyz="-${base_length/2 + 0.004} -0.092 0.090" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.006 0.042 0.020"/>
            </geometry>
            <origin xyz="-${base_length/2 + 0.012} -0.092 0.090" rpy="0 0 0"/>
            <material name="taillight_red"><color rgba="0.95 0.08 0.08 1.0"/></material>
        </visual>
        <!-- 15. Rear Center Amber Hazard Bar -->
        <visual>
            <geometry>
                <box size="0.006 0.080 0.014"/>
            </geometry>
            <origin xyz="-${base_length/2 + 0.004} 0 0.095" rpy="0 0 0"/>
            <material name="hazard_amber"><color rgba="1.0 0.65 0.05 1.0"/></material>
        </visual>
        <xacro:cuboid_collision lbh="${base_length} ${base_width} ${base_height}" o_xyz="0 0 ${base_height/2}" o_rpy="0 0 0"/>
        <xacro:cuboid_inertia m="${base_mass}" l="${base_length}" b="${base_width}" h="${base_height}" o_xyz="0 0 ${base_height/2}" o_rpy="0 0 0"/>
    </link>

    <!-- 6 High-Performance Drive Wheels with Dynamic Machined Rims & Orange Beadlock -->
    <xacro:rover_wheel_link prefix="rear_right" m="${wheel_mass}" l="${wheel_length}" r="${wheel_radius}" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>

    <xacro:rover_wheel_link prefix="rear_left" m="${wheel_mass}" l="${wheel_length}" r="${wheel_radius}" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>

    <xacro:rover_wheel_link prefix="mid_right" m="${wheel_mass}" l="${wheel_length}" r="${wheel_radius}" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>

    <xacro:rover_wheel_link prefix="mid_left" m="${wheel_mass}" l="${wheel_length}" r="${wheel_radius}" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>

    <xacro:rover_wheel_link prefix="front_right" m="${wheel_mass}" l="${wheel_length}" r="${wheel_radius}" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>

    <xacro:rover_wheel_link prefix="front_left" m="${wheel_mass}" l="${wheel_length}" r="${wheel_radius}" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>

    <!-- High-Tech Equipment Upper Deck (up_base_link) -->
    <link name="up_base_link">
        <!-- 1. Titanium Enclosure Body -->
        <visual>
            <geometry>
                <box size="0.32 ${base_width} 0.07"/>
            </geometry>
            <origin xyz="-0.04 0 0.035" rpy="0 0 0"/>
            <material name="titanium_deck"><color rgba="0.25 0.28 0.32 1.0"/></material>
        </visual>
        <!-- 2. Carbon Service Hatch Deck Plate -->
        <visual>
            <geometry>
                <box size="0.295 0.315 0.005"/>
            </geometry>
            <origin xyz="-0.04 0 0.0725" rpy="0 0 0"/>
            <material name="stealth_carbon"><color rgba="0.10 0.11 0.13 1.0"/></material>
        </visual>
        <!-- 3. Cyber Safety Orange Top Deck Hazard Edges -->
        <visual>
            <geometry>
                <box size="0.295 0.008 0.006"/>
            </geometry>
            <origin xyz="-0.04 0.158 0.073" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.295 0.008 0.006"/>
            </geometry>
            <origin xyz="-0.04 -0.158 0.073" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- 4. Left Equipment Grab Rails / Roll Bar -->
        <visual>
            <geometry>
                <cylinder radius="0.007" length="0.26"/>
            </geometry>
            <origin xyz="-0.04 0.150 0.092" rpy="0 ${pi/2} 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.014 0.014 0.028"/>
            </geometry>
            <origin xyz="0.08 0.150 0.080" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <box size="0.014 0.014 0.028"/>
            </geometry>
            <origin xyz="-0.16 0.150 0.080" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- 5. Right Equipment Grab Rails / Roll Bar -->
        <visual>
            <geometry>
                <cylinder radius="0.007" length="0.26"/>
            </geometry>
            <origin xyz="-0.04 -0.150 0.092" rpy="0 ${pi/2} 0"/>
