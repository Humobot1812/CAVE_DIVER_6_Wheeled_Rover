    <xacro:cylinder_link prefix="front_left_starter" m="0.05" l="0.061105" r="0.02" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>


    <joint name="base_front_left_starter_cylinder_joint" type="revolute">
        <parent link="base_link"/>
        <child link="front_left_starter_cylinder_link"/>      
        <origin xyz="0.1 0.20055 0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.05" upper="0" effort="500" velocity="20"/>
        <!-- <limit effort="100" velocity="10"/> -->
        <dynamics damping="1.0" friction="1.0"/>
    </joint>





    <xacro:cylinder_link prefix="front_right_mid" m="0.05" l="0.2704" r="0.02" x="0" y="0" z="0" roll="0" p="-1.1398" yaw="0"/>


    <joint name="starter_front_right_mid_cylinder_joint" type="fixed">
        <parent link="front_right_starter_cylinder_link"/>
        <child link="front_right_mid_cylinder_link"/>      
        <origin xyz="0.1125 -0.05055 -0.075" rpy="0 0 0"/>
    </joint>


    <xacro:cylinder_link prefix="front_left_mid" m="0.05" l="0.2704" r="0.02" x="0" y="0" z="0" roll="0" p="-1.1398" yaw="0"/>


    <joint name="starter_front_left_mid_cylinder_joint" type="fixed">
        <parent link="front_left_starter_cylinder_link"/>
        <child link="front_left_mid_cylinder_link"/>      
        <origin xyz="0.1125 0.05055 -0.075" rpy="0 0 0"/>
    </joint>



    <xacro:cylinder_link prefix="front_right_last" m="0.05" l="0.021105" r="0.02" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>


    <joint name="mid_front_right_last_cylinder_joint" type="fixed">
        <parent link="front_right_mid_cylinder_link"/>
        <child link="front_right_last_cylinder_link"/>      
        <origin xyz="0.1125 -0.03055 -0.07499" rpy="0 0 0"/>
    </joint>


    <xacro:cylinder_link prefix="front_left_last" m="0.05" l="0.021105" r="0.02" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>


    <joint name="mid_front_left_last_cylinder_joint" type="fixed">
        <parent link="front_left_mid_cylinder_link"/>
        <child link="front_left_last_cylinder_link"/>      
        <origin xyz="0.1125 0.03055 -0.07499" rpy="0 0 0"/>
    </joint>



    <joint name="last_front_right_wheel_joint" type="continuous">
        <parent link="front_right_last_cylinder_link"/>
        <child link="front_right_wheel_link"/>
        <axis xyz="0 1 0"/>        
        <origin xyz="0 -0.0330525 0" rpy="0 0 0"/>
        <limit effort="100" velocity="10"/>
        <dynamics damping="1.0" friction="1.0"/>
