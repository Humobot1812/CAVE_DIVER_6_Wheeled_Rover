    </joint>


    <xacro:cylinder_link prefix="rear_left_last" m="0.05" l="0.021105" r="0.02" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>


    <joint name="mid_rear_left_last_cylinder_joint" type="fixed">
        <parent link="rear_left_mid_cylinder_link"/>
        <child link="rear_left_last_cylinder_link"/>      
        <origin xyz="-0.1125 0.03055 -0.07499" rpy="0 0 0"/>
    </joint>






    <joint name="base_footprint_base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius + 0.1}" rpy="0 0 0"/>
    </joint>




    <joint name="base_up_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="up_base_link"/>
        <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    </joint>




    <joint name="last_rear_right_wheel_joint" type="continuous">
        <parent link="rear_right_last_cylinder_link"/>
        <child link="rear_right_wheel_link"/>
        <axis xyz="0 1 0"/>        
        <origin xyz="0 -0.0330525 0" rpy="0 0 0"/>
        <limit effort="100" velocity="10"/>
        <dynamics damping="1.0" friction="1.0"/>
    </joint>


    <joint name="last_rear_left_wheel_joint" type="continuous">
        <parent link="rear_left_last_cylinder_link"/>
        <child link="rear_left_wheel_link"/>
        <axis xyz="0 1 0"/>        
        <origin xyz="0 0.0330525 0" rpy="0 0 0"/>
        <limit effort="100" velocity="10"/>
