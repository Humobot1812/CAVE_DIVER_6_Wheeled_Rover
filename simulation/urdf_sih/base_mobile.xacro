    </joint>







    <xacro:wheel_link prefix="camera_base" m="0.065" l="0.015" r="0.02" x="0" y="0" z="0.0075" roll="0" p="0" yaw="0" material="machined_alloy"/>

    <joint name="base_camera_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_base_wheel_link"/>
        <origin xyz="0.16 0 ${base_height} " rpy="0 0 0"/>
    </joint>

    <xacro:wheel_link prefix="camera_cylinder" m="0.045" l="0.035" r="0.0075" x="0" y="0" z="0.0175" roll="0" p="0" yaw="0" material="gunmetal_suspension"/>

    <joint name="camera_base_cylinder_joint" type="revolute">
        <parent link="camera_base_wheel_link"/>
        <child link="camera_cylinder_wheel_link"/>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-2.0943" upper="${pi/2.0}" effort="1.0" velocity="2.0"/>
        <dynamics friction="0.01" damping="0.005"/>
    </joint>

    <!-- Dual-Sensor RGB + Thermal Gimbal Camera Turret -->
    <link name="camera_sphere_link">
        <!-- Main Turret Body -->
        <visual>
            <geometry>
                <sphere radius="0.017"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <!-- Dual Sensor Front Faceplate -->
        <visual>
            <geometry>
                <box size="0.006 0.036 0.022"/>
            </geometry>
            <origin xyz="0.012 0 0" rpy="0 0 0"/>
            <material name="stealth_carbon"><color rgba="0.10 0.11 0.13 1.0"/></material>
        </visual>
        <!-- RGB Camera Lens Bezel (Left Port) -->
        <visual>
            <geometry>
                <cylinder radius="0.007" length="0.005"/>
            </geometry>
            <origin xyz="0.014 0.009 0" rpy="0 ${pi/2} 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <!-- RGB Camera Optical Lens Glass -->
        <visual>
            <geometry>
                <cylinder radius="0.0055" length="0.002"/>
            </geometry>
            <origin xyz="0.016 0.009 0" rpy="0 ${pi/2} 0"/>
            <material name="headlight_xenon"><color rgba="0.92 0.96 1.0 1.0"/></material>
        </visual>
        <!-- Thermal Camera Lens Bezel (Right Port) -->
        <visual>
            <geometry>
                <cylinder radius="0.007" length="0.005"/>
            </geometry>
            <origin xyz="0.014 -0.009 0" rpy="0 ${pi/2} 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <!-- Thermal Camera Germanium IR Lens (Amber/Gold Coated) -->
        <visual>
            <geometry>
                <cylinder radius="0.0055" length="0.002"/>
            </geometry>
            <origin xyz="0.016 -0.009 0" rpy="0 ${pi/2} 0"/>
            <material name="hazard_amber"><color rgba="1.0 0.65 0.05 1.0"/></material>
        </visual>
        <!-- Sensor Status / Calibration Indicator -->
        <visual>
            <geometry>
                <cylinder radius="0.002" length="0.002"/>
            </geometry>
            <origin xyz="0.015 0 0.007" rpy="0 ${pi/2} 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- High-Power LED Flashlight Reflector & Lens (Center-Lower Port) -->
        <visual>
            <geometry>
                <cylinder radius="0.005" length="0.004"/>
            </geometry>
            <origin xyz="0.014 0 -0.005" rpy="0 ${pi/2} 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <cylinder radius="0.004" length="0.002"/>
            </geometry>
            <origin xyz="0.016 0 -0.005" rpy="0 ${pi/2} 0"/>
            <material name="headlight_xenon"><color rgba="0.95 0.98 1.0 1.0"/></material>
        </visual>
        <xacro:sphere_inertia m="0.03" r="0.017" o_xyz="0 0 0" o_rpy="0 0 0"/>
        <xacro:sphere_collision r="0.017" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="camera_cylinder_sphere_joint" type="revolute">
        <parent link="camera_cylinder_wheel_link"/>
        <child link="camera_sphere_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="${-pi/2.0}" upper="${pi/2.0}" effort="1.0" velocity="2.0"/>
        <dynamics friction="0.01" damping="0.005"/>
    </joint>
    
    <!-- RGB Camera Optical Frame -->
    <link name="optical_camera_link"/>
    <joint name="camera_optical_camera_link" type="fixed">
        <parent link="camera_sphere_link"/>
        <child link="optical_camera_link"/>
        <origin xyz="0.016 0.009 0" rpy="-1.57 0 -1.57"/>
    </joint>

    <!-- Thermal Camera Optical Frame -->
    <link name="optical_thermal_camera_link"/>
    <joint name="camera_optical_thermal_camera_link" type="fixed">
        <parent link="camera_sphere_link"/>
        <child link="optical_thermal_camera_link"/>
        <origin xyz="0.016 -0.009 0" rpy="-1.57 0 -1.57"/>
    </joint>

    <link name="thermal_camera_link"/>
    <joint name="camera_thermal_camera_link" type="fixed">
        <parent link="camera_sphere_link"/>
        <child link="thermal_camera_link"/>
        <origin xyz="0.016 -0.009 0" rpy="0 0 0"/>
    </joint>

    <!-- High-Precision 3D Multi-Beam LiDAR Sensor (scan_link) -->
    <link name="scan_link">
        <!-- Sensor Base Enclosure -->
        <visual>
            <geometry>
                <box size="0.0605 0.069 0.020"/>
            </geometry>
            <origin xyz="0 0 -0.035" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <!-- CNC Machined Aluminum Heat-Sink Cooling Collar -->
        <visual>
            <geometry>
                <cylinder radius="0.035" length="0.012"/>
            </geometry>
            <origin xyz="0 0 -0.021" rpy="0 0 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <!-- 3D LiDAR 360-Degree Optical Housing Drum -->
        <visual>
            <geometry>
                <cylinder radius="0.033" length="0.030"/>
            </geometry>
            <origin xyz="0 0 0.000" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <!-- Optical Sensor Lens Glass Band -->
        <visual>
            <geometry>
                <cylinder radius="0.0335" length="0.018"/>
            </geometry>
            <origin xyz="0 0 0.000" rpy="0 0 0"/>
            <material name="headlight_xenon"><color rgba="0.92 0.96 1.0 1.0"/></material>
        </visual>
        <!-- Upper Emitter/Receiver Multi-Beam Diode Ring -->
        <visual>
            <geometry>
                <cylinder radius="0.034" length="0.003"/>
            </geometry>
            <origin xyz="0 0 0.006" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- Lower Emitter/Receiver Multi-Beam Diode Ring -->
        <visual>
            <geometry>
                <cylinder radius="0.034" length="0.003"/>
            </geometry>
            <origin xyz="0 0 -0.006" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- Top Armor Cap -->
        <visual>
            <geometry>
                <cylinder radius="0.032" length="0.006"/>
            </geometry>
            <origin xyz="0 0 0.018" rpy="0 0 0"/>
            <material name="stealth_carbon"><color rgba="0.10 0.11 0.13 1.0"/></material>
        </visual>
        <!-- Top Status Indicator Dot -->
        <visual>
            <geometry>
                <cylinder radius="0.008" length="0.002"/>
            </geometry>
            <origin xyz="0 0 0.021" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <xacro:cuboid_collision lbh="0.07 0.07 0.065" o_xyz="0 0 -0.008" o_rpy="0 0 0"/>
        <xacro:cuboid_inertia m="0.25" l="0.07" b="0.07" h="0.065" o_xyz="0 0 -0.008" o_rpy="0 0 0"/>
    </link>

    <joint name="scan_joint" type="fixed">
        <origin xyz="0.0 0 ${0.07+0.045}" rpy="0 0 0"/>
        <child link="scan_link"/>
        <parent link="up_base_link"/>
    </joint>

    <link name="imu_link"/>
    <joint name="imu_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_link"/>
        <child link="imu_link" />
    </joint>


</robot>

