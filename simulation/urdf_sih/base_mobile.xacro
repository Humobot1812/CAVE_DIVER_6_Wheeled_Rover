    <xacro:cylinder_link prefix="front_right_starter" m="0.05" l="0.061105" r="0.02" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>


    <joint name="base_front_right_starter_cylinder_joint" type="revolute">
        <parent link="base_link"/>
