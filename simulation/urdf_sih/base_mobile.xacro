    </joint>

    <xacro:cylinder_link prefix="middle_right_last" m="0.05" l="0.021105" r="0.02" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>

    <joint name="mid_middle_right_last_cylinder_joint" type="fixed">
        <parent link="middle_right_mid_cylinder_link"/>
