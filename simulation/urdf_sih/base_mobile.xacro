    <joint name="last_front_left_wheel_joint" type="continuous">
        <parent link="front_left_last_cylinder_link"/>
        <child link="front_left_wheel_link"/>
        <axis xyz="0 1 0"/>        
        <origin xyz="0 0.0330525 0" rpy="0 0 0"/>
        <limit effort="100" velocity="10"/>
        <dynamics damping="1.0" friction="1.0"/>
    </joint>


    <!-- Middle Wheel Suspension (Branching from front starter cylinder links) -->
    <xacro:cylinder_link prefix="middle_right_mid" m="0.05" l="0.2440" r="0.02" x="0" y="0" z="0" roll="0" p="0.9086" yaw="0"/>

    <joint name="starter_middle_right_mid_cylinder_joint" type="fixed">
        <parent link="front_right_starter_cylinder_link"/>
        <child link="middle_right_mid_cylinder_link"/>      
        <origin xyz="-0.0962 -0.05055 -0.075" rpy="0 0 0"/>
    </joint>

    <xacro:cylinder_link prefix="middle_left_mid" m="0.05" l="0.2440" r="0.02" x="0" y="0" z="0" roll="0" p="0.9086" yaw="0"/>

    <joint name="starter_middle_left_mid_cylinder_joint" type="fixed">
        <parent link="front_left_starter_cylinder_link"/>
