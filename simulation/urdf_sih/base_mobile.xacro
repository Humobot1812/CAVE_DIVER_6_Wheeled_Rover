        <visual>
            <geometry>
                <cylinder radius="0.0035" length="0.12"/>
            </geometry>
            <origin xyz="-0.180 0.12 0.138" rpy="0 0.12 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <sphere radius="0.0055"/>
            </geometry>
            <origin xyz="-0.187 0.12 0.198" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- 7. Right Tactical Telemetry Antenna -->
        <visual>
            <geometry>
                <cylinder radius="0.009" length="0.018"/>
            </geometry>
            <origin xyz="-0.175 -0.12 0.078" rpy="0 0 0"/>
            <material name="sensor_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <cylinder radius="0.0035" length="0.12"/>
            </geometry>
            <origin xyz="-0.180 -0.12 0.138" rpy="0 0.12 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <sphere radius="0.0055"/>
            </geometry>
            <origin xyz="-0.187 -0.12 0.198" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <!-- 8. CNC Machined LiDAR Riser Pedestal -->
        <visual>
            <geometry>
                <cylinder radius="0.038" length="0.012"/>
            </geometry>
            <origin xyz="0 0 0.076" rpy="0 0 0"/>
            <material name="machined_alloy"><color rgba="0.80 0.82 0.85 1.0"/></material>
        </visual>
        <visual>
            <geometry>
                <cylinder radius="0.034" length="0.008"/>
            </geometry>
            <origin xyz="0 0 0.086" rpy="0 0 0"/>
            <material name="safety_orange"><color rgba="1.0 0.40 0.02 1.0"/></material>
        </visual>
        <xacro:cuboid_collision lbh="0.32 ${base_width} 0.07" o_xyz="-0.04 0 0.035" o_rpy="0 0 0"/>
        <xacro:cuboid_inertia m="1.709" l="0.32" b="${base_width}" h="0.07" o_xyz="-0.04 0 0.035" o_rpy="0 0 0"/>
    </link>



    <xacro:cylinder_link prefix="rear_right_starter" m="0.05" l="0.061105" r="0.02" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>


    <joint name="base_rear_right_starter_cylinder_joint" type="revolute">
        <parent link="base_link"/>
        <child link="rear_right_starter_cylinder_link"/>      
        <origin xyz="-0.1 -0.20055 0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.05" upper="0" effort="500.0" velocity="20"/>
        <dynamics damping="1.0" friction="1.0"/>
    </joint>


    <xacro:cylinder_link prefix="rear_left_starter" m="0.05" l="0.061105" r="0.02" x="0" y="0" z="0" roll="${pi/2}" p="0" yaw="0"/>


