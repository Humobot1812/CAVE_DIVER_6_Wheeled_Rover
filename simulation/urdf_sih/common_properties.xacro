<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- High-Tech Industrial Rover Materials -->
    <material name="stealth_carbon">
        <color rgba="0.10 0.11 0.13 1.0"/>
    </material>

    <material name="safety_orange">
        <color rgba="1.0 0.40 0.02 1.0"/>
    </material>

    <material name="cyber_orange">
        <color rgba="1.0 0.45 0.05 1.0"/>
    </material>

    <material name="machined_alloy">
        <color rgba="0.80 0.82 0.85 1.0"/>
    </material>

    <material name="titanium_deck">
        <color rgba="0.25 0.28 0.32 1.0"/>
    </material>

    <material name="gunmetal_suspension">
        <color rgba="0.30 0.33 0.37 1.0"/>
    </material>

    <material name="tread_rubber">
        <color rgba="0.05 0.05 0.06 1.0"/>
    </material>

    <material name="headlight_xenon">
        <color rgba="0.92 0.96 1.0 1.0"/>
    </material>

    <material name="taillight_red">
        <color rgba="0.95 0.08 0.08 1.0"/>
    </material>

    <material name="hazard_amber">
        <color rgba="1.0 0.65 0.05 1.0"/>
    </material>

    <material name="gold_accent">
        <color rgba="0.85 0.65 0.15 1.0"/>
    </material>

    <material name="chassis_dark">
        <color rgba="0.12 0.13 0.15 1.0"/>
    </material>

    <material name="deck_slate">
        <color rgba="0.24 0.26 0.29 1.0"/>
    </material>

    <material name="rubber_black">
        <color rgba="0.06 0.06 0.06 1.0"/>
    </material>

    <material name="suspension_metal">
        <color rgba="0.32 0.35 0.38 1.0"/>
    </material>

    <material name="metallic_silver">
        <color rgba="0.78 0.80 0.83 1.0"/>
    </material>

    <material name="sensor_black">
        <color rgba="0.03 0.03 0.03 1.0"/>
    </material>

    <material name="industrial_orange">
        <color rgba="1.0 0.40 0.02 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.06 0.06 0.06 1.0"/>
    </material>

    <material name="white">
        <color rgba="0.92 0.94 0.96 1.0"/>
    </material>

    <material name="grey">
        <color rgba="0.45 0.47 0.50 1.0"/>
    </material>

    <material name="dark_grey">
        <color rgba="0.18 0.20 0.22 1.0"/>
    </material>

    <material name="red">
        <color rgba="0.85 0.12 0.12 1.0"/>
    </material>

    <material name="green">
        <color rgba="0.15 0.65 0.30 1.0"/>
    </material>

    <material name="blue">
        <color rgba="0.12 0.40 0.75 1.0"/>
    </material>

    <material name="yellow">
        <color rgba="0.95 0.78 0.10 1.0"/>
    </material>

    <material name="orange">
        <color rgba="1.0 0.40 0.02 1.0"/>
    </material>

    <xacro:macro name="cuboid_collision" params="lbh o_xyz o_rpy">
        <collision>
            <geometry>
                <box size="${lbh}"/>
            </geometry>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
        </collision>
    </xacro:macro>

    <xacro:macro name="cuboid_inertia" params="m l b h o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(m/12) * (b*b + h*h)}" ixy="0" ixz="0"
                     iyy="${(m/12) * (l*l + h*h)}" iyz="0"
                     izz="${(m/12) * (l*l + b*b)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_collision" params="r l o_xyz o_rpy">
        <collision>
            <geometry>
                <cylinder radius="${r}" length="${l}"/>
            </geometry>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
        </collision>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(m/12) * (3*r*r + l*l)}" ixy="0" ixz="0"
                     iyy="${(m/12) * (3*r*r + l*l)}" iyz="0"
                     izz="${(m/2) * (r*r)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_collision" params="r o_xyz o_rpy">
        <collision>
            <geometry>
                <sphere radius="${r}" />
            </geometry>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
        </collision>
    </xacro:macro>





    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(2/5) * m * r * r}" ixy="0" ixz="0"
                     iyy="${(2/5) * m * r * r}" iyz="0"
                     izz="${(2/5) * m * r * r}" />
        </inertial>
    </xacro:macro>


</robot>
